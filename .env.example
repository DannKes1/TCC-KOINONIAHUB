# Variáveis do docker-compose.prod.yml. Copie para .env (ignorado pelo git) e preencha.
# Nunca versione o .env: ele tem a senha do banco e a chave do JWT.

# Domínio público, sem https://. O Caddy emite o certificado para ele e para www.
DOMINIO=koinoniahub.com.br

# PostgreSQL (contêiner db). A senha deve ser aleatória; gere no servidor com
#   openssl rand -base64 24
# Vazia, o contêiner do PostgreSQL se recusa a subir.
POSTGRES_DB=koinoniahub
POSTGRES_USER=koinoniahub
POSTGRES_PASSWORD=

# Chave do JWT (HS256): 48 bytes aleatórios em base64 (64 caracteres); gere com
#   openssl rand -base64 48
# Vazia, a API não sobe. Trocar a chave invalida todas as sessões abertas.
JWT_CHAVE_SECRETA=

# Fuso da igreja: dia civil dos relatórios e da pendência de fechamento (Igreja:FusoHorario).
IGREJA_FUSO_HORARIO=America/Porto_Velho
